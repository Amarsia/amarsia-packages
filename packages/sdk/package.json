{
  "name": "@amarsia/sdk",
  "version": "1.0.0",
  "description": "The official JavaScript and TypeScript SDK for Amarsia — run, stream, and manage AI assistants.",
  "license": "MIT",
  "author": "Amarsia",
  "repository": {
    "type": "git",
    "url": "https://github.com/Amarsia/amarsia-packages",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/Amarsia/amarsia-packages/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/Amarsia/amarsia-packages/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ai",
    "sdk",
    "amarsia",
    "assistant",
    "streaming",
    "llm",
    "orchestration",
    "agent builder",
    "ai sdk",
    "typescript sdk",
    "javascript sdk",
    "conversation api",
    "stateful ai sdk",
    "multimodal ai"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
