{
  "name": "@amarsia/react",
  "version": "1.2.2",
  "description": "The official React and Next.js SDK wrapper for Amarsia — build AI assistants with stateful hooks.",
  "license": "MIT",
  "author": "Amarsia",
  "repository": {
    "type": "git",
    "url": "https://github.com/Amarsia/amarsia-packages",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/Amarsia/amarsia-packages/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/Amarsia/amarsia-packages/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ai",
    "sdk",
    "amarsia",
    "assistant",
    "streaming",
    "llm",
    "orchestration",
    "agent builder",
    "react",
    "nextjs",
    "react hooks",
    "ai chat",
    "stateful hooks",
    "react ai sdk",
    "nextjs ai sdk"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@amarsia/sdk": "^1.2.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
