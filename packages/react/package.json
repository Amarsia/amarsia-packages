{
  "name": "@amarsia/react",
  "version": "0.1.1",
  "description": "React/Next.js wrapper package for the Amarsia SDK.",
  "license": "MIT",
  "author": "Amarsia",
  "repository": {
    "type": "git",
    "url": "https://github.com/Amarsia/amarsia-packages"
  },
  "homepage": "https://github.com/Amarsia/amarsia-packages/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/Amarsia/amarsia-packages/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@amarsia/sdk": "^0.1.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
